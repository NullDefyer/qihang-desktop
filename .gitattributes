* text=auto
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.css text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
# Windows PowerShell / NSIS files retain UTF-8 BOM and use CRLF.
*.ps1 text eol=crlf
*.nsh text eol=crlf
*.png binary
*.jpg binary
*.ico binary
*.exe binary
